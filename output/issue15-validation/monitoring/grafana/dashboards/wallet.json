{
  "uid": "issue15-wallet",
  "title": "用户钱包与消费 · 预生产验收",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "Asia/Shanghai",
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "issue15",
    "validation"
  ],
  "panels": [
    {
      "id": 1,
      "title": "采集状态",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "暂无有效数据",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "采集成功",
                  "color": "green"
                },
                "0": {
                  "text": "采集失败 / 尚未初始化",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "new_api_wallet_snapshot_success{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "采集状态",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "title": "快照年龄",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "暂无有效数据",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - new_api_wallet_snapshot_timestamp_seconds{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "年龄",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 3,
      "title": "最近成功更新",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": 2,
          "noValue": "暂无有效数据",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "new_api_wallet_snapshot_timestamp_seconds{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\"} * 1000",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "更新时间",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 4,
      "title": "七天历史状态",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "暂无有效数据",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "历史不足或端点不可用",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(new_api:user_net_quota:7d{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\",user_id=~\"$user_id\"}) or vector(0)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "历史状态",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 5,
      "title": "用户钱包余额",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "暂无有效数据",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "历史不足 / 端点不可用",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "用户 ID"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "余额 (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "日均消费 (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "预计天数"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "余额 (USD)"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "余额已耗尽 ($0.00)",
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "nan",
                      "result": {
                        "text": "采集不可用",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(new_api:user_wallet_balance_quota:valid{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\",user_id=~\"$user_id\"} or (new_api_user_wallet_balance_quota{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\",user_id=~\"$user_id\"} * NaN)) / 500000 * on(job,instance,deployment,user_id) group_left(username) new_api_user_info{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\",user_id=~\"$user_id\"}",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "余额",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(new_api:user_net_quota:daily7d{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\",user_id=~\"$user_id\"}/500000) or (new_api_user_wallet_balance_quota{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\",user_id=~\"$user_id\"} * NaN)",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "new_api:user_wallet:days7d{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\",user_id=~\"$user_id\"} or (new_api_user_wallet_balance_quota{job=\"new-api\",deployment=\"issue15-validation\",instance=\"host.docker.internal:33416\",user_id=~\"$user_id\"} * NaN)",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-prometheus"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "余额 (USD)",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "user_id",
            "mode": "outerTabular"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^user_id$",
            "renamePattern": "用户 ID"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^username$",
            "renamePattern": "用户名"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^Value #A$",
            "renamePattern": "余额 (USD)"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^Value #B$",
            "renamePattern": "日均消费 (USD)"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^Value #C$",
            "renamePattern": "预计天数"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "用户 ID",
                "用户名",
                "余额 (USD)",
                "日均消费 (USD)",
                "预计天数"
              ]
            }
          }
        }
      ]
    },
