{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "New API \u2014 user/model resources",
  "uid": "new-api-user-model-resources",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "tags": [
    "new-api",
    "resources"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"new-api\"},deployment)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"new-api\",deployment=\"$deployment\"},instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "user_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(new_api_user_model_limit{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\"},user_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(new_api_user_model_limit{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\"},model)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Collection health (0 = incomplete)",
      "type": "table",
      "description": "Check up and all components. Directory/counter caps and read failures are not zero demand.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "new_api_user_resource_scrape_success{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\"}",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Incomplete",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Component"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "component",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "component": 0,
              "Value": 1
            },
            "renameByName": {
              "component": "Component",
              "Value": "Health"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Model concurrency",
      "type": "timeseries",
      "description": "Shared Redis usage from the selected healthy target. Never sum replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "new_api:user_model_inflight:valid{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\",user_id=~\"$user_id\",model=~\"$model\"}",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Model RPM \u2014 last 60 seconds",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "new_api:user_model_rpm:valid{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\",user_id=~\"$user_id\",model=~\"$model\"}",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Estimated input TPM \u2014 last 60 seconds",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "new_api:user_model_input_tpm:valid{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\",user_id=~\"$user_id\",model=~\"$model\"}",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Concurrency occupancy",
      "type": "timeseries",
      "description": "Unlimited, blocked and unknown rows have no numeric ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "new_api:user_model_concurrency_ratio{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\",user_id=~\"$user_id\",model=~\"$model\"}",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Effective limits and enabled state",
      "type": "table",
      "description": "enabled=0 means unlimited; enabled=1 and limit=0 means blocked. Read both columns together.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "new_api_user_model_limit{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\",user_id=~\"$user_id\",model=~\"$model\",scope=\"redis\"} and on(job,instance,deployment,scope) (new_api_user_resource_scrape_success{component=\"config\",scope=\"redis\"} == 1) and on(job,instance,deployment) (up == 1)",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "new_api_user_model_limit_enabled{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\",user_id=~\"$user_id\",model=~\"$model\",scope=\"redis\"} and on(job,instance,deployment,scope) (new_api_user_resource_scrape_success{component=\"config\",scope=\"redis\"} == 1) and on(job,instance,deployment) (up == 1)",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "User ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 72
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Model"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 135
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Resource"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Limit"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Enabled"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "user_id",
                "model",
                "resource",
                "Value #A",
                "Value #B"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "user_id": 0,
              "model": 1,
              "resource": 2,
              "Value #A": 3,
              "Value #B": 4
            },
            "renameByName": {
              "user_id": "User ID",
              "model": "Model",
              "resource": "Resource",
              "Value #A": "Limit",
              "Value #B": "Enabled"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Model admissions / second \u2014 all processes",
      "type": "timeseries",
      "description": "Rate each process first, then sum. Resets after restart or 24h idle; missing scrapes reduce coverage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(deployment,user_id,model) (rate(new_api_user_model_admitted_requests_total{job=\"new-api\",deployment=\"$deployment\",user_id=~\"$user_id\",model=~\"$model\"}[5m]) and on(job,instance,deployment) (new_api_user_resource_scrape_success{component=\"counters\"} == 1))",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Model rejections / second \u2014 all processes",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(deployment,user_id,model,reason) (rate(new_api_user_model_rejected_requests_total{job=\"new-api\",deployment=\"$deployment\",user_id=~\"$user_id\",model=~\"$model\"}[5m]) and on(job,instance,deployment) (new_api_user_resource_scrape_success{component=\"counters\"} == 1))",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Configuration disagreement across healthy replicas",
      "type": "table",
      "description": "Nonempty means different effective limits/enabled states. Polling can cause temporary disagreement. No data can also mean missing targets; inspect health.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(deployment,user_id,model,resource) (new_api_user_model_limit{job=\"new-api\",deployment=\"$deployment\",user_id=~\"$user_id\",model=~\"$model\",scope=\"redis\"} and on(job,instance,deployment,scope) (new_api_user_resource_scrape_success{component=\"config\",scope=\"redis\"} == 1) and on(job,instance,deployment) (up == 1)) != min by(deployment,user_id,model,resource) (new_api_user_model_limit{job=\"new-api\",deployment=\"$deployment\",user_id=~\"$user_id\",model=~\"$model\",scope=\"redis\"} and on(job,instance,deployment,scope) (new_api_user_resource_scrape_success{component=\"config\",scope=\"redis\"} == 1) and on(job,instance,deployment) (up == 1))",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by(deployment,user_id,model,resource) (new_api_user_model_limit_enabled{job=\"new-api\",deployment=\"$deployment\",user_id=~\"$user_id\",model=~\"$model\",scope=\"redis\"} and on(job,instance,deployment,scope) (new_api_user_resource_scrape_success{component=\"config\",scope=\"redis\"} == 1) and on(job,instance,deployment) (up == 1)) != min by(deployment,user_id,model,resource) (new_api_user_model_limit_enabled{job=\"new-api\",deployment=\"$deployment\",user_id=~\"$user_id\",model=~\"$model\",scope=\"redis\"} and on(job,instance,deployment,scope) (new_api_user_resource_scrape_success{component=\"config\",scope=\"redis\"} == 1) and on(job,instance,deployment) (up == 1))",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Monitored concurrency coverage \u2014 samples per day",
      "type": "timeseries",
      "description": "30s rules yield at most 2880 samples/day. Gaps and policies without ratios reduce coverage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count_over_time(new_api:user_model_concurrency_ratio{job=\"new-api\",deployment=\"$deployment\",instance=\"$instance\",user_id=~\"$user_id\",model=~\"$model\"}[1d])",
          "legendFormat": "{{user_id}} {{model}} {{reason}} {{component}} {{resource}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
